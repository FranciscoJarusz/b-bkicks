PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_publishable_key
PUBLIC_ADMIN_EMAIL=admin@tu-dominio.com
PUBLIC_SUPABASE_PRODUCT_IMAGES_BUCKET=productos

# Cloudinary: hosting de las imagenes de productos (suben desde el panel admin)
PUBLIC_CLOUDINARY_CLOUD_NAME=dyktbpocd
PUBLIC_CLOUDINARY_UPLOAD_PRESET=BBKICKS

# Solo del servidor: firman las subidas del admin y borran imagenes.
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Recomendado para importar/migrar datos desde scripts locales:
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
