PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_publishable_key
PUBLIC_ADMIN_EMAIL=admin@tu-dominio.com
PUBLIC_SUPABASE_PRODUCT_IMAGES_BUCKET=productos

# Cloudinary: hosting de las imagenes de productos (suben desde el panel admin)
PUBLIC_CLOUDINARY_CLOUD_NAME=dyktbpocd
PUBLIC_CLOUDINARY_UPLOAD_PRESET=BBKICKS

# Solo del servidor: firman las subidas del admin y borran imagenes.
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Recomendado para importar/migrar datos desde scripts locales:
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# Solo del servidor: pagos con MercadoPago y pedidos.
# Access token de la cuenta que cobra (credenciales de prueba o de produccion).
MP_ACCESS_TOKEN=tu_access_token
# Secret key de Supabase (sb_secret_...): para guardar pedidos. Nunca PUBLIC_.
SUPABASE_SECRET_KEY=tu_secret_key
# CallMeBot: aviso por WhatsApp al dueno cuando se aprueba un pago. Se saca
# registrando el numero de WHATSAPP_NUMERO en callmebot.com.
CALLMEBOT_APIKEY=tu_apikey
