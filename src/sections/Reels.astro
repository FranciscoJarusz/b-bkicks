---
import ReelCargando from "@/components/ReelCargando.astro";
import ReelsLista from "@/components/ReelsLista.astro";
---

<section
    id="reels"
    class="mx-auto w-full bg-white max-w-7xl px-4 py-16 lg:gap-14 lg:px-6"
>
    <div
        data-reels
        class="relative -mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-6 scrollbar-none md:mx-0 md:px-0 motion-reduce:scroll-auto [&::-webkit-scrollbar]:hidden"
    >
        <ReelsLista server:defer>
            <Fragment slot="fallback">
                {
                    [1, 2, 3].map(() => (
                        <ReelCargando class="aspect-9/16 w-81.5 shrink-0 snap-center md:w-[calc((100%-1.5rem)/2)] md:snap-start xl:w-[calc((100%-3rem)/3)]" />
                    ))
                }
            </Fragment>
        </ReelsLista>
    </div>
    <div
        data-controles
        hidden
        class="mt-6 flex items-center justify-center gap-4"
    >
        <button
            type="button"
            data-anterior
            aria-label="Reels anteriores"
            class="grid size-10 cursor-pointer place-items-center rounded-full text-black ring ring-black/20 transition-all duration-300 hover:bg-primary hover:text-white hover:ring-primary disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-black disabled:hover:ring-black/20"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="size-5"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 19.5L8.25 12l7.5-7.5"></path>
            </svg>
        </button>
        <div data-puntos class="flex items-center gap-2"></div>
        <button
            type="button"
            data-siguiente
            aria-label="Reels siguientes"
            class="grid size-10 cursor-pointer place-items-center rounded-full text-black ring ring-black/20 transition-all duration-300 hover:bg-primary hover:text-white hover:ring-primary disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-black disabled:hover:ring-black/20"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="size-5"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
            </svg>
        </button>
    </div>
</section>

<script>
    const seccion = document.querySelector<HTMLElement>("#reels");
    const contenedor = seccion?.querySelector<HTMLElement>("[data-reels]");
    const controles = seccion?.querySelector<HTMLElement>("[data-controles]");
    const puntos = seccion?.querySelector<HTMLElement>("[data-puntos]");
    const anterior =
        seccion?.querySelector<HTMLButtonElement>("[data-anterior]");
    const siguiente =
        seccion?.querySelector<HTMLButtonElement>("[data-siguiente]");

    const ESPERA_MAXIMA = 15000;

    function ocultarSiNoCargo() {
        if (!contenedor?.querySelector("[data-listo]"))
            seccion?.classList.add("hidden");
    }

    const esperas = new Map<Element, number>();
    const tamano = new ResizeObserver((entradas) => {
        for (const { target } of entradas) {
            clearTimeout(esperas.get(target));
            esperas.set(
                target,
                window.setTimeout(() => {
                    if ((target as HTMLElement).offsetHeight < 100) return;
                    target.parentElement?.setAttribute("data-listo", "");
                    tamano.unobserve(target);
                }, 300)
            );
        }
    });

    function vigilarIframes() {
        contenedor
            ?.querySelectorAll("iframe:not([data-vigilado])")
            .forEach((iframe) => {
                iframe.setAttribute("data-vigilado", "");
                tamano.observe(iframe);
            });
    }

    let pedido = false;

    function cargarEmbeds() {
        if (pedido || !contenedor?.querySelector(".instagram-media")) return;
        pedido = true;

        const { instgrm } = window as {
            instgrm?: { Embeds: { process(): void } };
        };
        if (instgrm) {
            instgrm.Embeds.process();
        } else {
            const script = document.createElement("script");
            script.src = "https://www.instagram.com/embed.js";
            script.async = true;
            script.onerror = ocultarSiNoCargo;
            document.body.append(script);
        }

        setTimeout(ocultarSiNoCargo, ESPERA_MAXIMA);
    }

    const reels = () =>
        contenedor ? [...contenedor.querySelectorAll(":scope > div")] : [];

    // Los reels que se ven enteros (o casi): en la compu son 2 o 3 a la vez,
    // y sus puntos se marcan juntos para que se entienda que parte se ve.
    function reelsVisibles() {
        if (!contenedor) return [];
        const { scrollLeft, clientWidth } = contenedor;
        return reels().flatMap((reel, i) => {
            const { offsetLeft, offsetWidth } = reel as HTMLElement;
            const centro = offsetLeft + offsetWidth / 2;
            return centro >= scrollLeft && centro <= scrollLeft + clientWidth
                ? [i]
                : [];
        });
    }

    function marcarPunto() {
        if (!contenedor) return;
        const visibles = reelsVisibles();
        puntos?.querySelectorAll("button").forEach((punto, i) => {
            const activo = visibles.includes(i);
            punto.toggleAttribute("data-activo", activo);
            punto.setAttribute("aria-current", String(activo));
        });
        const { scrollLeft, scrollWidth, clientWidth } = contenedor;
        if (anterior) anterior.disabled = scrollLeft <= 2;
        if (siguiente)
            siguiente.disabled = scrollLeft + clientWidth >= scrollWidth - 2;
    }

    // Avanza de a una "pagina": tantos reels como entran en pantalla.
    function pasar(direccion: number) {
        const [primero, segundo] = reels() as HTMLElement[];
        if (!contenedor || !primero) return;
        const paso = segundo
            ? segundo.offsetLeft - primero.offsetLeft
            : primero.offsetWidth;
        const porPantalla = Math.max(1, reelsVisibles().length);
        contenedor.scrollBy({ left: direccion * paso * porPantalla });
    }

    function armarPuntos() {
        if (!contenedor || !puntos) return;
        const lista = reels();
        if (controles)
            controles.hidden =
                contenedor.scrollWidth <= contenedor.clientWidth + 2;
        if (puntos.childElementCount !== lista.length) {
            puntos.replaceChildren(
                ...lista.map((_, i) => {
                    const punto = document.createElement("button");
                    punto.type = "button";
                    punto.ariaLabel = `Ver reel ${i + 1}`;
                    punto.className =
                        "h-2 w-2 cursor-pointer rounded-full bg-black/20 transition-all duration-300 hover:bg-black/40 data-activo:w-6 data-activo:bg-primary";
                    punto.addEventListener("click", () => {
                        const reel = reels()[i] as HTMLElement | undefined;
                        if (!reel) return;
                        contenedor.scrollTo({
                            left:
                                reel.offsetLeft -
                                (contenedor.clientWidth - reel.offsetWidth) / 2,
                        });
                    });
                    return punto;
                })
            );
        }
        marcarPunto();
    }

    if (contenedor) {
        let enPantalla = false;

        contenedor.addEventListener("scroll", marcarPunto, { passive: true });
        anterior?.addEventListener("click", () => pasar(-1));
        siguiente?.addEventListener("click", () => pasar(1));
        new ResizeObserver(armarPuntos).observe(contenedor);

        new MutationObserver(() => {
            armarPuntos();
            vigilarIframes();
            if (enPantalla) cargarEmbeds();
        }).observe(contenedor, { childList: true, subtree: true });

        const visible = new IntersectionObserver(
            ([entrada]) => {
                if (!entrada.isIntersecting) return;
                visible.disconnect();
                enPantalla = true;
                cargarEmbeds();
            },
            { rootMargin: "600px 0px" }
        );

        visible.observe(contenedor);
    }
</script>
