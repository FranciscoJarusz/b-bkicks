---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import CatalogoConFiltros from "@/components/ui/CatalogoConFiltros.jsx";
import { getEncargos } from "@/utils/productos.js";

const encargos = await getEncargos();
---

<Layout
    title="Encargos"
    description="Encargá tu par en B&B KICKS. Compramos solo en retailers oficiales para garantizar la autenticidad total. Entrega estimada de 15 a 20 días."
>
    <Header />

    {
        encargos.length > 0 ? (
            <CatalogoConFiltros
                productos={encargos}
                basePath="/encargos"
                titulo="Todos los productos para encargo"
                mostrarTodosLosTalles
                client:load
            />
        ) : (
            <section class="py-16">
                <div class="max-w-7xl mx-auto px-6">
                    <p class="text-black/60">
                        Todavía no hay productos disponibles para encargar.
                    </p>
                </div>
            </section>
        )
    }
</Layout>
