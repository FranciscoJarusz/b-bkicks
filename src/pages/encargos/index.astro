---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Card from '@/components/ui/Card.jsx';
import { getEncargos } from '@/utils/productos.js';

const encargos = await getEncargos();
---

<Layout
    title="Encargos"
    description="Encargá tu par en B&B KICKS. Compramos solo en retailers oficiales para garantizar la autenticidad total. Entrega estimada de 15 a 20 días."
>
    <Header />

    <section class="py-16">
        <div class="flex flex-col gap-8 lg:gap-16 max-w-7xl mx-auto px-6">

            <div class="flex flex-col gap-6">
                <h1 class="text-4xl lg:text-6xl text-primary font-accent uppercase animate-fade-in-down">
                    Encargos
                </h1>
            </div>

            {encargos.length > 0 ? (
                <div class="grid grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-20 animate-fade-in-down animate-delay-500">
                    {encargos.map((producto, index) => (
                        <Card
                            producto={producto}
                            basePath="/encargos"
                            mostrarTodosLosTalles
                            priority={index < 3}
                            client:load
                        />
                    ))}
                </div>
            ) : (
                <p class="text-black/60">Todavía no hay productos disponibles para encargar.</p>
            )}

        </div>
    </section>
</Layout>
