---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
---

<Layout
    title="404"
    description="La pagina que buscabas no existe o ya no esta disponible en B&B KICKS."
    noindex={true}
>
    <Header />

    <section class="relative isolate overflow-hidden">
        <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(204,10,10,0.08),transparent_42%)]"
        >
        </div>

        <div
            class="relative z-10 mx-auto flex min-h-[calc(100dvh-9rem)] max-w-7xl items-center px-6 py-16 sm:px-8 lg:px-10"
        >
            <div
                class="grid w-full gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center"
            >
                <div class="max-w-3xl">
                    <p
                        class="mb-5 text-xs font-semibold uppercase tracking-[0.38em] text-black/45"
                    >
                        Error 404
                    </p>

                    <h1
                        class="max-w-4xl font-accent text-5xl leading-[0.9] text-primary sm:text-6xl lg:text-7xl"
                    >
                        ESTA PAGINA NO
                        <br />
                        ENCONTRO SU PAR.
                    </h1>

                    <p
                        class="mt-6 max-w-2xl text-base leading-8 text-black/70 sm:text-lg"
                    >
                        Puede que el producto ya no exista, que la URL haya
                        cambiado o que el link este roto. Volve al catalogo y
                        segui buscando tu proximo par.
                    </p>

                    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                        <a
                            href="/"
                            class="inline-flex min-h-13 items-center justify-center rounded-full bg-primary px-7 text-base font-semibold text-secondary transition-all duration-300 hover:bg-primary-accent"
                        >
                            Volver al inicio
                        </a>

                        <a
                            href="/busqueda"
                            class="inline-flex min-h-13 items-center justify-center rounded-full border border-black/15 px-7 text-base font-semibold text-black transition-all duration-300 hover:border-primary hover:text-primary"
                        >
                            Ir al catalogo
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
