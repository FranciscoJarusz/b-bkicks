{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.vercel-scripts.com https://connect.facebook.net;"
                }
            ]
        }
    ]
}
